{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true
  },
  "include": ["index.js", "src/**/*.js", "src/**/*.d.ts"]
}
